---
import MerciLayout from "../layouts/MerciLayout.astro";

const base = import.meta.env.BASE_URL;
---

<MerciLayout>
    <section class="error-page">
        <div class="error-content">

            <p class="error-code">404</p>

            <h1>Page introuvable</h1>

            <p>
                Désolé, la page que vous recherchez
                n'existe pas ou à été déplacée.
            </p>

            <a href={base} class="home-button">
                Retour à l'accueil
            </a>

        </div>
    </section>
</MerciLayout>

<style>
    .error-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .error-content {
        max-width: 600px;
        padding: 2rem;
    }

    .error-code {
        margin: 0;
        color: var(--primary-color);
        font-size: clamp(5rem, 15vw, 10rem);
        font-weight: 800;
        line-height: 1;
    }

    h1 {
        margin: 1rem 0;
        font-size: clamp(2rem, 5vw, 3rem);
    }

    .error-content p:not(.error-code) {
        margin-bottom: 2rem;
        color: var(--text-color);
    }

    .home-button {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        background: var(--primary-color);
        color: #111827;
        text-decoration: none;
        font-weight: 700;
        transition: transform 0.2s ease;
    }

    .home-button:hover {
        transform: translateY(-2px);
    }
</style>