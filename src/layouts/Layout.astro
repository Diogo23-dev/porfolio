---
import Nav from "../components/Nav.astro";
import "../assets/css/global.css";
import "../assets/css/utility.css";
import "@fortawesome/fontawesome-free/css/all.css";
import WhatsApp from "../components/WhatsApp.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <GoogleAnalytics />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}logo.svg`}
    />

    <meta name="generator" content={Astro.generator} />

    <meta
      name="description"
      content="Portfolio de Abdoulaye Diogo Diallo, développeur web spécialisé dans la conception d'applications web."
    />

    <meta
      name="author"
      content="Abdoulaye Diogo Diallo"
    />

	<link rel="canonical" href={Astro.url} />
    <title>Abdoulaye Diogo Diallo | Développeur Web</title>

	<!-- Open Graph -->
    <meta
      property="og:title"
      content="Abdoulaye Diogo Diallo | Développeur Web"
    />

    <meta
      property="og:description"
      content="Découvrez mon portfolio, mes projets et mes compétences en développement web et Analyse de données."
    />

    <meta property="og:type" content="website" />

    <meta property="og:url" content={Astro.url} />

    <meta
      property="og:image"
      content={`${Astro.site}${base}portfolio.png`}
    />

    <meta property="og:locale" content="fr_FR" />

	<!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content="Abdoulaye Diogo Diallo | Développeur Web"
    />

    <meta
      name="twitter:description"
      content="Découvrez mon portfolio, mes projets et mes compétences en développement web et Analyse de données."
    />

    <meta
      name="twitter:image"
      content={`${Astro.site}${base}portfolio.png`}
    />

  </head>

  <body>
    <Nav />
    <WhatsApp />

    <main>
      <slot />
    </main>

  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    scroll-behavior: smooth;
  }

  section {
    width: 100%;
    padding: 4rem 1rem;
    overflow: hidden;
    scroll-margin-top: 90px;
  }
</style>