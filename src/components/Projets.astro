---
import ProjectCard from './ProjetCard.astro';
---
<section id="projects" class="projects container">
    <div class="division"></div>
    <div class="content-text">
        <h2>Mes projets</h2>
        <p>Découvrez quelques projets réalisés avec différentes technologies.</p>
    </div>
    <div class="projects-container">
        <ProjectCard  title="Portfolio développeur" description="Un site portfolio moderne pour présenter mon profil, mes compétences et mes réalisations." technologies={['Astro']} image="/portfolio.png" liendoc="http://localhost:4321/blog/portfolio" lienrepo="https://github.com/Diogo23-dev/porfolio" />
        <ProjectCard  title="Gestion scolaire" description="Application de gestion des élèves, notes et paiements." technologies={['Laravel', 'Livewire', 'MySQL']} image="/departement.jpg" liendoc="http://localhost:4321/blog/gestion-scolaire" lienrepo="#" />
    </div>

</section>