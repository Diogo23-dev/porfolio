---
const {title, description, technologies, image, liendoc, lienrepo} = Astro.props;
---


    <div class="project-card">
        <img src={image} alt={title}>
        <div class="project-content">
            <h3>{title}</h3>
            <p>
            {description}
            </p>

            <div class="technologies">
                {technologies.map((tech) => (
                    <span>{tech}</span>
                ))}
            </div>

            <div class="project-links">
                <a href={ liendoc }>
                    Voir le projet
                </a>

                <a href={ lienrepo } target="_blank">
                    GitHub
                </a>
            </div>

        </div>

    </div>
