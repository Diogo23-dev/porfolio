          <a href={`${base}#maison`}>
            <!-- <img src="logo.svg" alt="Your Logo"/> -->
          <svg id="logo" width="180" height="60" viewBox="0 0 180 60" xmlns="http://www.w3.org/2000/svg">

            <text
                x="5"
                y="42"
                font-family="geist mono"
                font-size="38"
                font-weight="bold"
                fill="#ffcd42">
                &lt;
            </text>

            <text
                x="35"
                y="42"
                font-family="geist pixel"
                font-size="38"
                font-weight="bold"
                fill="currentColor">
                DAD
            </text>

            <text
                x="110"
                y="42"
                font-family="geist mono"
                font-size="38"
                font-weight="bold"
                fill="#ffcd42">
                /&gt;
            </text>

          </svg>
          </a>
        </h1>
        <!-- Navbar links -->
        <ul class="nav-menu">
          <li><a class="nav-link" href={`${base}#maison`}>ACCUEIL</a></li>
          <li><a class="nav-link" href={`${base}#competences`}>COMPETENCES</a></li>
          <li><a class="nav-link" href={`${base}#projects`}>PROJETS</a></li>
          <li><a class="nav-link" href={`${base}#contact`}>CONTACTE</a></li>
          <li>
            <a
              class="nav-link btn btn-primary"
              href={`${base}/pdf/DialloAbdoulayeDiogo.pdf`}
              >CV 
              <svg class="fas fa-arrow-right" viewBox="0 0 500 500"><path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg>
            </a>
          </li>
        </ul>

          <!-- Toggle switch -->
        <div class="theme-switch">
          <input type="checkbox" id="switch" />
          <label class="toggle-icons" for="switch">
            <img class="moon" src={`${base}/moon.svg`} />
            <img class="sun" src={`${base}/sun.svg`} />
            </label>
        </div>
      </div>
    </nav>
      <!-- Navbar Mobile -->
      <nav class="mobile-nav">
          <a href={`${base}#maison`} class="nav-link active">
              <i class="fas fa-home"></i>
              <!-- <span class="nav-text">Accueil</span> -->
          </a>
    
          <a href={`${base}#competences`} class="nav-link" >
              <i class="fas fa-laptop-code"></i>
              <!-- <span class="nav-text">Projects</span> -->
          </a>
    
          <a href={`${base}#projects`} class="nav-link" >
              <i class="fas fa-briefcase"></i>
              <!-- <span class="nav-text">Projects</span> -->
          </a>
    
          <a href={`${base}#contact`} class="nav-link">
              <i class="fas fa-envelope"></i> <br>
              <!-- <span class="nav-text">Contact</span> -->
          </a>
    
          <a class="nav-link btn btn-primary" href={`${base}/pdf/DialloAbdoulayeDiogo.pdf`} download>
              <i class="fas fa-download"></i>
              <span style="font-weight: bolder;">CV</span>
              <svg class="fas fa-arrow-right" viewBox="0 0 500 500"><path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg>
          </a>
      </nav>
      <ul>
        <li style="margin-left: 200px;">Bonjour</li>
      </ul>
</header>

<script>

const toggleSwitch = document.querySelector(
  '.theme-switch input[type="checkbox"]'
);

function switchTheme(e) {
  if (e.target.checked) {
    document.documentElement.setAttribute("data-theme", "dark");
  } else {
    document.documentElement.setAttribute("data-theme", "light");
  }
}

toggleSwitch.addEventListener("change", switchTheme, false);
  
</script>